{
  "name": "dsh-codex-sub",
  "version": "0.0.0-development",
  "description": "ChatGPT subscription authentication and OpenAI Codex models for DeepSeek Harness.",
  "private": true,
  "license": "UNLICENSED",
  "type": "module",
  "sideEffects": false,
  "packageManager": "pnpm@11.7.0",
  "engines": {
    "node": "^22.19.0 || >=24.0.0"
  },
  "main": "lib/index.mjs",
  "types": "lib/index.d.mts",
  "exports": {
    ".": {
      "types": "./lib/index.d.mts",
      "default": "./lib/index.mjs"
    },
    "./compatibility.json": "./compatibility.json",
    "./package.json": "./package.json"
  },
  "files": [
    "lib",
    "cordis.patch.yml",
    "compatibility.json",
    "README.md",
    "README.ja.md"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  },
  "scripts": {
    "build": "tsdown src/index.ts --format esm --dts --out-dir lib --clean",
    "typecheck": "tsc --noEmit",
    "lint": "oxlint src tests scripts",
    "test": "vitest run",
    "check:boundaries": "node scripts/check-core-boundaries.mjs",
    "check:compatibility": "node scripts/check-compatibility.mjs",
    "pack:check": "node scripts/check-pack.mjs",
    "check": "pnpm run lint && pnpm run typecheck && pnpm run test && pnpm run check:boundaries && pnpm run build && pnpm run check:compatibility && pnpm run pack:check"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "4.0.1",
    "@deepseek-ai/dsh-attachment": "0.1.0-rc.7",
    "@deepseek-ai/dsh-atomic-write": "0.1.0-rc.7",
    "@deepseek-ai/dsh-home-paths": "0.1.0-rc.7",
    "@deepseek-ai/dsh-llm": "0.1.0-rc.7",
    "@deepseek-ai/dsh-llm-pi-ai": "0.1.0-rc.7"
  },
  "dependencies": {
    "@earendil-works/pi-ai": "0.82.1"
  },
  "devDependencies": {
    "@deepseek-ai/cordis": "4.0.1",
    "@deepseek-ai/dsh-attachment": "0.1.0-rc.7",
    "@deepseek-ai/dsh-atomic-write": "0.1.0-rc.7",
    "@deepseek-ai/dsh-home-paths": "0.1.0-rc.7",
    "@deepseek-ai/dsh-llm": "0.1.0-rc.7",
    "@deepseek-ai/dsh-llm-pi-ai": "0.1.0-rc.7",
    "@types/node": "^22.20.0",
    "oxlint": "1.76.0",
    "tsdown": "0.22.2",
    "typescript": "6.0.3",
    "vitest": "4.1.8"
  }
}
